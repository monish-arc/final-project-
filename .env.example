# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional. Enables Google Maps Platform basemap tiles.
# Required for Google-quality STREET / SATELLITE / HYBRID / TERRAIN basemaps.
# When not set, the map falls back to free Esri + OpenStreetMap tiles (no key required).
# Obtain from: https://console.cloud.google.com/apis/credentials
# Enable the "Maps Tiles API" in your Google Cloud project.
# IMPORTANT: Restrict the key to HTTP referrers: localhost:3000/* and your production domain.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_API_BASE_URL: Production backend origin. The frontend prefixes this to every
# /api/* request at runtime. When unset, requests stay relative (/api/...) so the
# local Vite dev proxy keeps working.
VITE_API_BASE_URL="https://safemove-ai.onrender.com"

# Backend-only Google Maps key (for tile proxy or server-side usage, future enhancement).
GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# SAFE_MOVE_AI live-data services (all server-side; keys never reach the browser)
# ---------------------------------------------------------------------------

# --- Open-Meteo (no key required). Primary provider for WeatherService. ---
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
WEATHER_CACHE_TTL_SEC="600"
WEATHER_TIMEOUT_SEC="15"

# --- ECMWF backup (no key) ----------------------------------------------------
# Served through the standard Open-Meteo /forecast contract by selecting the
# `ecmwf_ifs04` model (the legacy /v1/ecmwf endpoint has no /forecast suffix).
# Used only when the Open-Meteo primary is unreachable. ECMWF (IFS 0.25°) does
# not provide relative humidity or pressure — those fields stay null/disabled
# while the backup is serving.
ECMWF_BASE_URL="https://api.open-meteo.com/v1"
WEATHER_FORECAST_DAYS="7"        # forecast horizon for /api/weather (1..7)
WEATHER_GRID_STEP="0.25"         # default India-wide grid cell size (degrees)
WEATHER_GRID_MAX_POINTS="600"    # cap for /api/weather/grid
WEATHER_GRID_CACHE_TTL_SEC="600" # grid-cache TTL (defaults to WEATHER_CACHE_TTL_SEC)
WEATHER_BATCH_SIZE="50"          # grid cells per upstream multi-location request

# --- IMD Mausam Current Weather (LEGACY, optional, disabled by default) ------
# Only when BOTH values are set does IMD rejoin the chain as a last-resort
# primary (backward compatibility). The default chain is Open-Meteo (primary)
# -> ECMWF (backup); IMD is otherwise not used.
IMD_MAUSAM_BASE_URL=""
IMD_MAUSAM_TOKEN=""
IMD_MAUSAM_TIMEOUT_SEC="12"
TERRAIN_CACHE_TTL_SEC="86400"
TERRAIN_GRID_SAMPLES="8"          # cardinal samples used for slope estimation
TERRAIN_SAMPLE_KM="1.2"           # sample ring radius for slope (Open-Meteo only)

# --- Terrain: NASA Earthdata SRTM (PRIMARY) with opt-in Open-Meteo fallback ---
# NASA_EARTHDATA_TOKEN: Earthdata Login bearer token (JWT). Resolved in order:
#   1. this env var
#   2. EARTHDATA_TOKEN (shared NASA token, also used by GPM rainfall)
#   3. the operator's local `apikeynasa.env` / `apikeynasa.env.env` file at the
#      repository root (bare JWT or NASA_EARTHDATA_TOKEN=... line)
# The token is consumed server-side only and never logged or sent to the browser.
# Renew the token at https://urs.earthdata.nasa.gov (User Tokens).
NASA_EARTHDATA_TOKEN=""
NASA_SRTM_LPDAAC_URL_TEMPLATE="https://data.lpdaac.earthdatacloud.nasa.gov/lp-prod-protected/SRTMGL1.003/{tile}.SRTMGL1.hgt/{tile}.SRTMGL1.hgt.zip"
NASA_SRTM_TIMEOUT_SEC="30"
NASA_SRTM_MAX_TILES="3"
NASA_TERRAIN_SAMPLE_ARCSEC="3"    # real slope window size in arc-seconds (~90 m)
TERRAIN_DB_CACHE="on"             # persist validated NASA SRTM samples (terrain_samples table)
# Open-Meteo remains available ONLY if explicitly turned on; its payloads are
# always clearly labelled as fallback and never presented as NASA data.
NASA_TERRAIN_FALLBACK_OPENMETEO="off"

# --- Copernicus CDS / GloFAS (job-based API; requires CDS account) ---
# Set credentials AND provide a downloaded/cached GloFAS dataset in GLOPAS_DATA_DIR
# (see backend/scripts). Without both, /api/flood-risk returns "Data unavailable".
CDS_API_URL="https://cds.climate.copernicus.eu/api/v2"
CDS_API_KEY=""
CDS_API_SECRET=""
GLOPAS_DATA_DIR=""
GLOPAS_DATASET="cems-glofas-forecast"
FLOOD_CACHE_TTL_SEC="1800"

# --- NASA GPM / GES DISC (bulk HDF5 tiles; Earthdata login required) ---
GPM_MODE="off"                    # "off" until an IMERG tile is ingested into GPM_DATA_DIR
GPM_DATA_DIR=""
EARTHDATA_USERNAME=""
# EARTHDATA_TOKEN: NASA Earthdata Login token (a JWT; NOT a plain API key). GES DISC
# accepts it as "Authorization: Bearer <token>". Valid ~60 days — renew at
# https://urs.earthdata.nasa.gov (User Tokens). Store locally in backend/.env
# (gitignored); the backend config auto-loads that file. To ingest a fresh IMERG
# tile run:  python scripts/fetch_gpm_data.py --recent  from the backend/ folder.
EARTHDATA_TOKEN=""
RAINFALL_CACHE_TTL_SEC="3600"

# --- OpenStreetMap providers (respect provider usage policies; cached) ---
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_MIN_INTERVAL_SEC="1.5"   # minimum interval between Overpass requests
NEARBY_RADIUS_KM_DEFAULT="20.0"
NEARBY_CACHE_TTL_SEC="1800"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODE_CACHE_TTL_SEC="2592000"
GEOCODE_MIN_INTERVAL_SEC="1.0"
OSM_USER_AGENT="NammaSafeAI-DisasterDecisionSupport/1.0 (govt pilot)"

# --- Routing: "local" (curated risk-aware A*) | "osrm" | "auto" ---
ROUTING_PROVIDER="local"
OSRM_BASE_URL="https://router.project-osrm.org"
ROUTER_CACHE_TTL_SEC="1800"

# --- Risk assessment engine (transparent rule-based weights) ---
# JSON object; adjust weights without code changes. Missing signals are
# normalised out so absent data never deflates the score.
RISK_ASSESSMENT_WEIGHTS='{"rainfall":0.25,"water":0.25,"elevation":0.20,"historical":0.15,"proximity":0.10,"field_damage":0.05,"lulc":0.06,"geoid":0.02}'
ASSESSMENT_MODE="rule_based"      # rule_based | hybrid | ml (ml requires ML_MODEL_PATH)
ML_MODEL_PATH=""
HISTORICAL_EVENT_RADIUS_KM="50.0"
FIELD_REPORT_RADIUS_KM="25.0"

# --- Bhuvan / ISRO (India geospatial supporting layer) ---
# Access token: obtain by login at https://bhuvan.nrsc.gov.in (Bhuvan portal) and
# request API access; refresh daily / per-theme as per the Bhuvan API policy.
# BHUVAN_API_TOKEN is used by village geocode, reverse geocode, hospitals, LULC
# 50K/250K and intra-state routing. BHUVAN_API_KEY is used by the CartoDEM geoid
# tile API only. Both are operator secrets: keep them in backend/.env (gitignored).
BHUVAN_API_BASE_URL="https://bhuvan-app1.nrsc.gov.in/api"
BHUVAN_API_TOKEN=""
BHUVAN_API_KEY=""
BHUVAN_TIMEOUT_SEC="15"
BHUVAN_CACHE_TTL_SEC="86400"
BHUVAN_GEOCODE_TTL_SEC="2592000"
BHUVAN_RISK_FACTOR="off"           # "on" lets Bhuvan LULC/geoid factors join the risk engine
